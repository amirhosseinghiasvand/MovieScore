{
  "manifest_version": 3,
  "name": "MovieScore Browser Helper",
  "version": "1.2.0",
  "description": "Reads public Letterboxd and Metacritic movie data in your normal Chrome browser and sends it back to your local MovieScore app.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://letterboxd.com/*",
    "https://www.metacritic.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8765/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://127.0.0.1:8765/*"],
      "js": ["moviescore.js", "metacritic-moviescore.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://letterboxd.com/*"],
      "js": ["letterboxd.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.metacritic.com/movie/*"],
      "js": ["metacritic.js"],
      "run_at": "document_idle"
    }
  ]
}
